%%
%% omreply.sty
%% Minimal style for referee-response letters.
%%
%% Usage:
%%   \documentclass[11pt]{article}
%%   \usepackage{omreply}
%%
%% omphys.sty is optional and may be loaded independently when its
%% physics/math macros are needed.
%%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{omreply}[2026/08/29 OM referee-response style]

\makeatletter

%% ------------------------------------------------------------
%% Options
%% ------------------------------------------------------------

\newif\ifomreply@geometry
\newif\ifomreply@romanequations

\omreply@geometrytrue
\omreply@romanequationstrue

\DeclareOption{geometry}{\omreply@geometrytrue}
\DeclareOption{nogeometry}{\omreply@geometryfalse}
\DeclareOption{romanequations}{\omreply@romanequationstrue}
\DeclareOption{arabicequations}{\omreply@romanequationsfalse}

\ProcessOptions\relax

%% ------------------------------------------------------------
%% Required package
%% ------------------------------------------------------------

\RequirePackage{xcolor}

%% ------------------------------------------------------------
%% Page layout and equation numbering
%% ------------------------------------------------------------

\ifomreply@geometry
  \RequirePackage[
    top=30truemm,
    bottom=30truemm,
    left=25truemm,
    right=25truemm
  ]{geometry}
\fi

\ifomreply@romanequations
  \renewcommand{\theequation}{\roman{equation}}
\fi

%% ------------------------------------------------------------
%% Tunable appearance
%% ------------------------------------------------------------

\newlength{\replyblocksep}
\setlength{\replyblocksep}{0.5\baselineskip}


\definecolor{editorbrown}{RGB}{125,70,20}
\providecommand{\replyeditorcolor}{editorbrown}
\providecommand{\replyrefereecolor}{blue}

%% ------------------------------------------------------------
%% Manuscript metadata
%% ------------------------------------------------------------

%% These defaults remain conspicuous if a template value is not replaced.
%% Define them before loading omreply, or renew them afterwards.
\providecommand{\manuscriptID}{MANUSCRIPT ID}
\providecommand{\Title}{MANUSCRIPT TITLE}
\providecommand{\Journal}{JOURNAL}
\providecommand{\Authors}{AUTHOR NAME(S)}

%% ------------------------------------------------------------
%% Cover-letter helpers
%% ------------------------------------------------------------

\newcommand{\replydate}[1][\today]{%
  \par
  \vspace{\replyblocksep}%
  \begin{flushright}
    #1
  \end{flushright}%
}

\newcommand{\replysalutation}[1][Editor]{%
  \par\noindent
  Dear #1,%
  \par\medskip
}

\newcommand{\replyclosing}[1]{%
  \par\medskip
  \noindent Sincerely,%
  \par\noindent
  #1%
  \par
}

%% ------------------------------------------------------------
%% Point-by-point reply structure
%% ------------------------------------------------------------

\newcommand{\replyheading}[1]{%
  \part*{#1}%
}

\newcommand{\replytoeditor}[1][the Editor]{%
  \replyheading{Reply to #1}%
}

\newcommand{\replytoreferee}[1][the referee]{%
  \replyheading{Reply to #1 and summary of changes made}%
}

%% Backward-compatible one-block commands.
%% For new documents, editorcomment and refereecomment are preferable because
%% they naturally accept several paragraphs and displayed equations.
\newcommand{\editor}[1]{%
  \par\noindent
  \begingroup
    \color{\replyeditorcolor}\slshape
    #1\par
  \endgroup
}

\newcommand{\referee}[1]{%
  \par\noindent
  \begingroup
    \color{\replyrefereecolor}\slshape
    #1\par
  \endgroup
}

\newenvironment{editorcomment}
  {%
    \par\addvspace{\replyblocksep}%
    \noindent
    \begingroup
      \color{\replyeditorcolor}\slshape
      \ignorespaces
  }
  {%
      \par
    \endgroup
    \addvspace{\replyblocksep}%
    \ignorespacesafterend
  }

\newenvironment{refereecomment}
  {%
    \par\addvspace{\replyblocksep}%
    \noindent
    \begingroup
      \color{\replyrefereecolor}\slshape
      \ignorespaces
  }
  {%
      \par
    \endgroup
    \addvspace{\replyblocksep}%
    \ignorespacesafterend
  }

\newenvironment{authorresponse}
  {%
    \par\addvspace{\replyblocksep}%
    \noindent
    \ignorespaces
  }
  {%
    \par\addvspace{\replyblocksep}%
    \ignorespacesafterend
  }

%% A compact separator is occasionally useful between the general report
%% and the numbered point-by-point comments.
\newcommand{\replysep}{%
  \par\addvspace{\replyblocksep}%
}

\makeatother

\endinput
